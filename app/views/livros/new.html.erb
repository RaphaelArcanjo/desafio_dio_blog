<h1>Cadastro</h1>
<form action="/livros/<%= @livro.id %>" method="<%= @livro.id ? 'put' : 'post' %>">
    <div class="mb-3">
        <label for="titulo" class="form-label">Título</label>
        <input class="form-control" type="text" value="<%= @livro.titulo %>" name="livro[titulo]" id="titulo" />
    </div>

    <div class="mb-3">
        <label for="autor" class="form-label">Autor</label>
        <input class="form-control" type="text" value="<%= @livro.autor %>" name="livro[autor]" id="autor" />
    </div>

    <div class="mb-3">
        <label for="nota" class="form-label">Nota</label>
        <input class="form-range" type="range" value="<%= @livro.nota %>" name="livro[nota]" id="nota" min="0" max="10" value="10" />
    </div>

    <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <textarea class="form-control" name="livro[descricao]" id="descricao"><%= @livro.descricao %></textarea>
    </div>

    <div class="mb-3">
        <input class="btn btn-primary" type="submit" value="Enviar" />
        <a href="/" class="btn btn-danger">Cancelar</a>
    </div>
</form>