<h1>Cadastro</h1>
<hr />
<a href="/"><- Cancelar</a>
<hr />
<form action="/livros/<%= @livro.id %>" method="<%= @livro.id ? 'put' : 'post' %>">
    <label for="titulo">Título</label>
    <input type="text" value="<%= @livro.titulo %>" name="livro[titulo]" id="titulo" />
    <br />

    <label for="autor">Autor</label>
    <input type="text" value="<%= @livro.autor %>" name="livro[autor]" id="autor" />
    <br />

    <label for="nota">Nota</label>
    <input type="range" value="<%= @livro.nota %>" name="livro[nota]" id="nota" min="0" max="10" value="10" />
    <br />

    <label for="descricao">Descrição</label>
    <textarea name="livro[descricao]" id="descricao"><%= @livro.descricao %></textarea>
    <br />

    <input type="submit" value="Enviar" />
</form>