<div class="card" style="width: 18rem;">
    <div class="card-header"><%= @livro.titulo %></div>
    
    <ul class="list-group list-group-flush">
        <li class="list-group-item">Nota: <%= @livro.nota %>/10 </li>
        <li class="list-group-item">Autor: <%= @livro.autor %></li>
        <li class="list-group-item">Descrição: <%= @livro.descricao %></li>
    </ul>

    <div class="card-footer">
        <div class="row text-center">
            <div class="col">
                <a href="/livros/<%= @livro.id %>/edit" method="get" class="btn btn-primary"> Editar </a>
            </div>

            <form action="/livros/<%= @livro.id %>" method="delete" class="col">
                <input type="submit" value="Excluir" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>